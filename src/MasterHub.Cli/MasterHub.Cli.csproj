<Project Sdk="Microsoft.NET.Sdk">

  <!-- masterhub-cli.exe: the command line of MasterHub (T-24). A separate console program: the app itself has no console. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>masterhub-cli</AssemblyName>
    <RootNamespace>MasterHub.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MasterHub.Core\MasterHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MasterHub.Core.Tests" />
  </ItemGroup>

</Project>
