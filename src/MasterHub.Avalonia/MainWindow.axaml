<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MasterHub.Avalonia.ViewModels"
        xmlns:nav="using:MasterHub.Avalonia.Views.Navigation"
        xmlns:win="using:MasterHub.Avalonia.Views.Window"
        xmlns:canvas="using:MasterHub.Avalonia.Views.Canvas"
        xmlns:inspector="using:MasterHub.Avalonia.Views.Inspector"
        xmlns:pages="using:MasterHub.Avalonia.Views.Pages"
        xmlns:controls="using:MasterHub.Avalonia.Views.Controls"
        x:Class="MasterHub.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cooler Master MasterHub"
        Width="1440" Height="900"
        MinWidth="1180" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="52"
        Background="{StaticResource WindowBgBrush}">

    <Window.Styles>
        <Style Selector="TextBlock#PART_Title">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Window.Styles>

    <!-- Rama okna (MainBg): pasek boczny na całą wysokość + pasek tytułu nad treścią.
         Strony leżą na niej jako pływające panele (Border.pagePanel, Styles/Shell.axaml). -->
    <!-- Jeden rytm odstępów: 16 px między paskiem bocznym, panelami i krawędziami okna; górne krawędzie wyrównane. -->
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="52,*">
        <win:TitleBarView Grid.Row="0" Grid.ColumnSpan="2" />
        <nav:NavigationSidebarView Grid.Row="1" Grid.Column="0" DataContext="{Binding Navigation}" />

        <Grid Grid.Row="1" Grid.Column="1">
            <Panel Margin="0,0,16,16">
                <!-- Studio: kanwa modułów + inspektor po prawej -->
                <Grid ColumnDefinitions="*,380" IsVisible="{Binding Navigation.IsStudioSelected}">
                    <Border Grid.Column="0" Classes="pagePanel" Margin="0,0,16,0">
                        <canvas:ModuleCanvasView DataContext="{Binding Canvas}" />
                    </Border>
                    <Border Grid.Column="1" Classes="pagePanel">
                        <inspector:InspectorPanelView DataContext="{Binding Inspector}" />
                    </Border>
                </Grid>

                <Border Classes="pagePanel" IsVisible="{Binding Navigation.IsProfilesSelected}">
                    <pages:ProfilesPageView DataContext="{Binding Profiles}" />
                </Border>
                <Border Classes="pagePanel" IsVisible="{Binding Navigation.IsActionStoreSelected}">
                    <pages:ActionStorePageView DataContext="{Binding ActionStore}" />
                </Border>
                <Border Classes="pagePanel" IsVisible="{Binding Navigation.IsMacrosSelected}">
                    <pages:MacrosPageView DataContext="{Binding Macros}" />
                </Border>
                <Border Classes="pagePanel" IsVisible="{Binding Navigation.IsLogsSelected}">
                    <pages:LogsPageView DataContext="{Binding Logs}" />
                </Border>
                <Border Classes="pagePanel" IsVisible="{Binding Navigation.IsSettingsSelected}">
                    <pages:SettingsPageView DataContext="{Binding Settings}" />
                </Border>
                <controls:QuarantineBannerView DataContext="{Binding Quarantine}" VerticalAlignment="Top" />
                <controls:ActiveTimersView DataContext="{Binding Canvas.ActiveTimers}" />
                <controls:DraftBannerView DataContext="{Binding Draft}" VerticalAlignment="Top" />
                <controls:TourView DataContext="{Binding Tour}" />
                <controls:AssistCardView DataContext="{Binding Assist}" />
            </Panel>
        </Grid>

        <!-- Banery błędów i ostrzeżeń (T-34 #8) – nad stronami, pod nakładką potwierdzeń -->
        <controls:NoticeBannerView Grid.Row="1" Grid.Column="1" DataContext="{Binding Notices}" />

        <!-- Nakładka potwierdzeń (nad całą zawartością okna, w tym paskiem tytułu) -->
        <controls:ConfirmOverlayView Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" DataContext="{Binding ConfirmOverlay}" />
    </Grid>
</Window>
