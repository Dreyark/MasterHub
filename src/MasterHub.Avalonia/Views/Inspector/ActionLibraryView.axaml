<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Inspector"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             xmlns:ctl="using:MasterHub.Avalonia.Views.Controls"
             x:Class="MasterHub.Avalonia.Views.Inspector.ActionLibraryView"
             x:DataType="vm:ActionLibraryViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="0,4">
        <!-- Hold / Double slot as the target: say so, offer the way back to Press, explain a refused pick -->
        <Border Grid.Row="0" Classes="statusBadgeCard" Padding="10,8" Margin="0,0,0,8" IsVisible="{Binding IsSlotBannerVisible}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding SlotBannerText}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{StaticResource AccentPrimaryBrush}" />
                <TextBlock Text="{Binding SlotNotice}" FontSize="10.5" TextWrapping="Wrap" Classes="dim" IsVisible="{Binding HasSlotNotice}" />
                <Button Classes="pillBtn" Padding="10,4" HorizontalAlignment="Left" Command="{Binding ReturnToPressCommand}"
                        Content="{loc:Loc Library_BackToPress}" />
            </StackPanel>
        </Border>

        <!-- Nagłówek kontekstowy wybranego manipulatora -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="{Binding ContextTitle}" FontSize="12" FontWeight="Bold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="1" Classes="statusBadgeCard" Padding="6,2" CornerRadius="6">
                <TextBlock Text="{Binding ManipulatorBadge}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentPrimaryBrush}" />
            </Border>
        </Grid>

        <!-- Pole wyszukiwania -->
        <TextBox Grid.Row="2" Text="{Binding SearchQuery}"
                 PlaceholderText="{loc:Loc Action_SearchPlaceholder}" Margin="0,0,0,8">
            <TextBox.InnerLeftContent>
                <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="10,0,0,0"
                          Foreground="{StaticResource TextMutedBrush}" />
            </TextBox.InnerLeftContent>
        </TextBox>

        <!-- Kategoria: jedna lista rozwijana zamiast ~20 kafelków zajmujących pół panelu -->
        <ComboBox Grid.Row="3" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategoryItem}"
                  Margin="0,0,0,8">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryFilterItem">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{Binding IconKey, Converter={x:Static ctl:IconConverters.ByKey}}" Width="14" Height="14"
                                  Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Lista akcji z zaokrąglonym podświetleniem (CornerRadius 10) i natychmiastowym przypisywaniem -->
        <ListBox Grid.Row="4" ItemsSource="{Binding FilteredItems}"
                 SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Padding="0">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,2" />
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ActionCatalogItem">
                    <Button Classes="rowBtn" HorizontalAlignment="Stretch"
                            Command="{Binding $parent[UserControl].((vm:ActionLibraryViewModel)DataContext).ChooseActionCommand}"
                            CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="iconTile" Margin="0,0,12,0">
                                <Panel>
                                    <Image Source="{Binding IconBitmap}" Width="20" Height="20"
                                           IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <PathIcon Data="{Binding IconKey, Converter={x:Static ctl:IconConverters.ByKey}}" Width="16" Height="16"
                                              Foreground="{StaticResource AccentPrimaryBrush}"
                                              IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                                </Panel>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <PathIcon Grid.Column="2" Classes="rowAdd" Data="{StaticResource IconPlus}" Width="12" Height="12"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
