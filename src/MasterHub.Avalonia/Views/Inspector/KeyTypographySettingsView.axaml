<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Inspector.KeyTypographySettingsView"
             x:DataType="vm:KeyItemViewModel">

    <StackPanel Spacing="10">
        <!-- Wybór fontu i rozmiaru czcionki -->
        <Grid ColumnDefinitions="*,1.2*" Margin="0,2,0,0">
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                <TextBlock Text="{loc:Loc Key_FontFamilyLabel}" Classes="caption" />
                <ComboBox ItemsSource="{x:Static vm:KeyItemViewModel.AvailableFontFamilies}" SelectedItem="{Binding FontFamily}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Loc Key_FontSizeLabel}" Classes="caption" />
                    <TextBlock Grid.Column="1" Text="{Binding FontSize, StringFormat='{}{0} pt'}" Classes="dim" />
                </Grid>
                <Slider Minimum="8" Maximum="24" Value="{Binding FontSize}" />
            </StackPanel>
        </Grid>

        <!-- Styl tekstu: Bold, Italic, Przekreślony -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
            <TextBlock Grid.Column="0" Text="{loc:Loc Key_TextStyle}" Classes="caption" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <ToggleButton Classes="pillBtn" Width="30" Height="26" Padding="0" IsChecked="{Binding IsBold}" ToolTip.Tip="{loc:Loc Key_BoldTip}">
                    <TextBlock Text="B" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ToggleButton>
                <ToggleButton Classes="pillBtn" Width="30" Height="26" Padding="0" IsChecked="{Binding IsItalic}" ToolTip.Tip="{loc:Loc Key_ItalicTip}">
                    <TextBlock Text="I" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ToggleButton>
                <ToggleButton Classes="pillBtn" Width="30" Height="26" Padding="0" IsChecked="{Binding IsStrikeThrough}" ToolTip.Tip="{loc:Loc Key_StrikeTip}">
                    <TextBlock Text="S" TextDecorations="Strikethrough" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ToggleButton>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
