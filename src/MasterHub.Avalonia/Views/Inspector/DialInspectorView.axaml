<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Inspector.DialInspectorView"
             x:DataType="vm:DialItemViewModel">

    <StackPanel Spacing="12">
        <!-- Nagłówek Dial IPS -->
        <Border Classes="inspectorSection">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="🎯" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Classes="h3" />
                    <TextBlock Text="{Binding LastDirectionDisplay}" Classes="dim" FontSize="10" />
                </StackPanel>
                <Button Grid.Column="2" Classes="iconBtn" Command="{Binding ClearActionCommand}"
                        IsVisible="{Binding HasAction}"
                        ToolTip.Tip="{loc:Loc Knob_ClearActionTip}" Padding="6">
                    <TextBlock Text="🗑️" FontSize="13" />
                </Button>
            </Grid>
        </Border>

        <!-- Odczyt kroków enkodera z przyciskiem resetu -->
        <Border Classes="statusBadgeCard" Padding="12,10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Loc Roller_RegisteredSteps}" Classes="caption" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StepsDisplay}" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource AccentSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Grid.Column="2" Classes="iconBtn" Click="OnResetStepsClick" ToolTip.Tip="{loc:Loc Knob_ResetStepsTip}">
                    <TextBlock Text="🔄" FontSize="11" />
                </Button>
            </Grid>
        </Border>

        <!-- Przypisana akcja obrotu i naciśnięcia tarczy -->
        <StackPanel Spacing="6">
            <TextBlock Text="{loc:Loc Dial_RotateAction}" Classes="caption" />
            <Border Classes="statusBadgeCard" Padding="12,8">
                <TextBlock Text="{Binding RotateActionDisplayName}" FontWeight="SemiBold" FontSize="11.5"
                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{loc:Loc Dial_PressAction}" Classes="caption" Margin="0,4,0,0" />
            <Border Classes="statusBadgeCard" Padding="12,8">
                <TextBlock Text="{Binding PressActionDisplayName}" FontWeight="SemiBold" FontSize="11.5"
                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Ekran IPS 240x240: Grafika, Kolor, Jasność -->
        <Border Classes="inspectorSection">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc Dial_ImageLabel}" Classes="caption" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <Button Grid.Column="0" Classes="pillBtn" Click="OnBrowseImageClick" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📁" FontSize="12" />
                            <TextBlock Text="{loc:Loc Dial_UploadBtn}" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="iconBtn" Click="OnClearImageClick"
                            IsVisible="{Binding HasCustomImage}" ToolTip.Tip="{loc:Loc Dial_ClearBtn}">
                        <TextBlock Text="🗑️" FontSize="12" />
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Loc Base_LedColorLabel}" Classes="caption" VerticalAlignment="Center" />
                    <ColorPicker Grid.Column="1" Color="{Binding Color, Mode=TwoWay}" IsAlphaEnabled="False" ToolTip.Tip="{loc:Loc Common_ColorPickerTip}" />
                </Grid>

                <!-- Paleta kolorów tła ekranu -->
                <ItemsControl ItemsSource="{Binding PresetColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="24" Height="24" Margin="2" CornerRadius="12" Padding="0"
                                    Background="{Binding Hex}" Tag="{Binding Hex}" Click="OnPresetColorClick"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    ToolTip.Tip="{Binding Name}" Cursor="Hand" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Jasność ekranu IPS -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Loc Dial_Brightness}" Classes="caption" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding BrightnessDisplay}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                </Grid>
                <Slider Minimum="0" Maximum="100" Value="{Binding Brightness}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
