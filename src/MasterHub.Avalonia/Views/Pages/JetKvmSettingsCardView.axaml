<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Pages"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Pages.JetKvmSettingsCardView"
             x:DataType="vm:SettingsPageViewModel">

    <Border Classes="glassCard" Padding="18">
        <StackPanel Spacing="14">
            <!-- Nagłówek i Status Połączenia JetKVM -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconJetKvm}" Width="18" Height="18"
                              Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc JetKvm_Title}" Classes="h3" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="2" Background="{Binding JetKvmConnectionStatusColor}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding JetKvmConnectionStatusText}" FontSize="11" FontWeight="Bold" Foreground="#0F1117" />
                </Border>
            </Grid>

            <TextBlock Text="{loc:Loc JetKvm_Subtitle}" Classes="dim" FontSize="11" />

            <!-- Konfiguracja sieciowa: Host / IP, Port, HTTPS -->
            <Grid ColumnDefinitions="2*,12,*,12,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc JetKvm_HostLabel}" Classes="caption" />
                    <TextBox Text="{Binding JetKvmHost, Mode=TwoWay}" PlaceholderText="{loc:Loc JetKvm_HostPlaceholder}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="{loc:Loc JetKvm_PortLabel}" Classes="caption" />
                    <TextBox Text="{Binding JetKvmPort, Mode=TwoWay}" PlaceholderText="80" />
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Bottom">
                    <CheckBox Content="{loc:Loc JetKvm_HttpsLabel}" IsChecked="{Binding JetKvmUseHttps, Mode=TwoWay}" Margin="0,0,0,4" />
                </StackPanel>
            </Grid>

            <!-- Hasło urządzenia JetKVM (opcjonalne) -->
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc JetKvm_AuthTokenLabel}" Classes="caption" />
                <TextBox Text="{Binding JetKvmAuthToken, Mode=TwoWay}" PasswordChar="•" PlaceholderText="{loc:Loc JetKvm_AuthTokenPlaceholder}" />
            </StackPanel>

            <!-- Karta stanu zasilania serwera (Power LED & HDD LED) oraz Auto-Connect -->
            <Border Classes="statusBadgeCard" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding JetKvmPowerStatusText}" FontWeight="Bold" FontSize="12" Foreground="{Binding JetKvmPowerStatusColor}" />
                            <TextBlock Text="{loc:Loc JetKvm_HddLedActive}" FontWeight="SemiBold" FontSize="11" Foreground="#38BDF8" IsVisible="{Binding IsJetKvmHddActive}" />
                        </StackPanel>
                        <TextBlock Text="{loc:Loc JetKvm_AutoConnectDesc}" Classes="dim" FontSize="10" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="{loc:Loc JetKvm_AutoConnect}" IsChecked="{Binding JetKvmAutoConnect, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Przyciski akcji: Połącz/Test połączenia, Rozłącz, Odśwież stan, Zapisz -->
            <StackPanel Spacing="8">
                <WrapPanel Orientation="Horizontal">
                    <Button Classes="pillBtn" Command="{Binding TestJetKvmConnectionCommand}"
                            IsEnabled="{Binding !IsJetKvmConnected}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔌" FontSize="12" />
                            <TextBlock Text="{loc:Loc JetKvm_TestConnectionBtn}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="pillBtn" Command="{Binding DisconnectJetKvmCommand}"
                            IsEnabled="{Binding IsJetKvmConnected}" Content="{loc:Loc JetKvm_DisconnectBtn}" Margin="0,0,8,8" />
                    <Button Classes="pillBtn" Command="{Binding RefreshJetKvmStateCommand}"
                            IsEnabled="{Binding IsJetKvmConnected}" Content="{loc:Loc JetKvm_RefreshStateBtn}" Margin="0,0,8,8" />
                    <Button Classes="pillBtn" Command="{Binding SaveJetKvmSettingsCommand}"
                            Content="{loc:Loc JetKvm_SaveSettings}" Margin="0,0,8,8" />
                </WrapPanel>

                <!-- Komunikat statusu i wskazówka konfiguracyjna -->
                <TextBlock Text="{Binding JetKvmStatusMessage}" Foreground="{Binding JetKvmStatusMessageColor}"
                           FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc JetKvm_ConfigTip}" Classes="dim" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
