<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Pages"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Pages.VlcSettingsCardView"
             x:DataType="vm:SettingsPageViewModel">

    <Border Classes="glassCard" Padding="18">
        <StackPanel Spacing="14">
            <!-- Nagłówek i Status Połączenia VLC -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconVlc}" Width="18" Height="18"
                              Foreground="#FF8800" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc Vlc_Title}" Classes="h3" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="2" Background="{Binding VlcConnectionStatusColor}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VlcConnectionStatusText}" FontSize="11" FontWeight="Bold" Foreground="#0F1117" />
                </Border>
            </Grid>

            <TextBlock Text="{loc:Loc Vlc_Subtitle}" Classes="dim" FontSize="11" />

            <!-- Host i Port VLC HTTP -->
            <Grid ColumnDefinitions="2*,12,1*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc Vlc_HostLabel}" Classes="caption" />
                    <TextBox Text="{Binding VlcHost, Mode=TwoWay}" PlaceholderText="127.0.0.1" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="{loc:Loc Vlc_PortLabel}" Classes="caption" />
                    <TextBox Text="{Binding VlcPort, Mode=TwoWay}" PlaceholderText="8080" />
                </StackPanel>
            </Grid>

            <!-- Hasło HTTP (VLC Lua Web) -->
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Vlc_PasswordLabel}" Classes="caption" />
                <TextBox Text="{Binding VlcPassword, Mode=TwoWay}" PasswordChar="●"
                         PlaceholderText="{loc:Loc Vlc_PasswordPlaceholder}" />
            </StackPanel>

            <!-- Opcje automatycznego łączenia i fallbacku -->
            <StackPanel Spacing="8">
                <CheckBox IsChecked="{Binding VlcAutoConnect, Mode=TwoWay}"
                          Content="{loc:Loc Vlc_AutoConnectLabel}" FontSize="12" />
                <CheckBox IsChecked="{Binding VlcFallbackToDesktopHotkeys, Mode=TwoWay}"
                          Content="{loc:Loc Vlc_FallbackHotkeysLabel}" FontSize="12" />
            </StackPanel>

            <!-- Status bieżącego odtwarzacza VLC -->
            <Border Classes="statusBadgeCard" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding VlcNowPlayingText}" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding VlcPlaybackStatusText}" FontSize="11" Foreground="#94A3B8" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding VlcFullscreenStatusText}" FontSize="11" Foreground="#94A3B8" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Przyciski akcji, testów sterowania i zapisu -->
            <StackPanel Spacing="8">
                <WrapPanel Orientation="Horizontal">
                    <Button Classes="pillBtn" Command="{Binding TestVlcConnectionCommand}"
                            IsEnabled="{Binding !IsVlcConnected}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔗" FontSize="12" />
                            <TextBlock Text="{loc:Loc Vlc_ConnectBtn}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="pillBtn" Command="{Binding DisconnectVlcCommand}"
                            IsEnabled="{Binding IsVlcConnected}" Content="{loc:Loc Vlc_DisconnectBtn}" Margin="0,0,8,8" />
                    <Button Classes="pillBtn" Command="{Binding RefreshVlcStateCommand}"
                            IsEnabled="{Binding IsVlcConnected}" Content="{loc:Loc Vlc_RefreshBtn}" Margin="0,0,8,8" />
                    <Button Classes="pillBtn" Command="{Binding TestVlcPlayPauseCommand}"
                            Content="{loc:Loc Vlc_TestPlayPauseBtn}" Margin="0,0,8,8" />
                    <Button Classes="pillBtn" Command="{Binding TestVlcStopCommand}"
                            Content="{loc:Loc Vlc_TestStopBtn}" Margin="0,0,8,8" />
                    <Button Classes="pillBtn" Command="{Binding TestVlcNextCommand}"
                            Content="{loc:Loc Vlc_TestNextBtn}" Margin="0,0,8,8" />
                    <Button Classes="pillBtn" Command="{Binding TestVlcPreviousCommand}"
                            Content="{loc:Loc Vlc_TestPrevBtn}" Margin="0,0,8,8" />
                    <Button Classes="pillBtn" Command="{Binding TestVlcFullscreenCommand}"
                            Content="{loc:Loc Vlc_TestFullscreenBtn}" Margin="0,0,8,8" />
                    <Button Classes="pillBtn" Command="{Binding SaveVlcSettingsCommand}"
                            Content="{loc:Loc Vlc_SaveBtn}" Margin="0,0,8,8" />
                </WrapPanel>

                <!-- Komunikat statusu i wskazówka -->
                <TextBlock Text="{Binding VlcStatusMessage}" Foreground="{Binding VlcStatusMessageColor}"
                           FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc Vlc_ConfigTip}" Classes="dim" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
