<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Pages.UpdatesCardView"
             x:DataType="vm:UpdatesViewModel">
    <!-- Sprawdzanie aktualizacji (T-32): wyłączone, dopóki użytkownik nie włączy i nie poda repozytorium. Tylko informuje - niczego nie instaluje. -->
    <Border Classes="glassCard" Padding="18">
        <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16"
                          Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Loc Update_Title}" Classes="h3" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{loc:Loc Update_Desc}" Classes="dim" FontSize="10.5" TextWrapping="Wrap" />

            <Border Classes="statusBadgeCard" Padding="14,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{loc:Loc Update_EnableTitle}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{loc:Loc Update_EnableDesc}" Classes="dim" FontSize="10.5" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc Update_RepoLabel}" FontWeight="SemiBold" FontSize="12" />
                <TextBox Text="{Binding Repository, Mode=TwoWay}" PlaceholderText="owner/name" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="actionBtn" Content="{loc:Loc Update_CheckNow}" Command="{Binding CheckNowCommand}"
                        IsEnabled="{Binding CanCheck}" />
            </Grid>

            <!-- jest nowa wersja: notatki i przycisk otwierający stronę wydania (nic nie jest pobierane przez aplikację) -->
            <Border Classes="callout" Padding="12" IsVisible="{Binding HasUpdate}">
                <StackPanel Spacing="8">
                    <ScrollViewer MaxHeight="140" IsVisible="{Binding HasNotes}">
                        <TextBlock Text="{Binding Notes}" FontSize="11" TextWrapping="Wrap" />
                    </ScrollViewer>
                    <Button Classes="actionBtn" Content="{loc:Loc Update_Open}" Command="{Binding OpenReleaseCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
