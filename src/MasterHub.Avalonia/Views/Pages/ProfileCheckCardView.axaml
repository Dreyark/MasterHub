<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Pages"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Pages.ProfileCheckCardView"
             x:DataType="vm:ProfilesPageViewModel">

    <StackPanel>
    <!-- Komunikat statusu po operacji eksportu lub importu -->
    <Border Classes="glassCard" Margin="0,0,0,16" Padding="14,10"
            IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*">
            <PathIcon Grid.Column="0" Data="{StaticResource IconCheck}" Width="14" Height="14"
                      Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
    </Border>

    <!-- Sprawdzenie profilu (T-34 #9): kontrolki, które wskazują coś, czego na tym PC nie ma -->
    <Border Classes="glassCard" Padding="14,12" Margin="0,0,0,16" IsVisible="{Binding IsCheckVisible}">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Grid.Column="0" Data="{StaticResource IconTarget}" Width="14" Height="14" Margin="0,0,10,0"
                          Foreground="{StaticResource AccentWarningBrush}" VerticalAlignment="Center" IsVisible="{Binding HasCheckFindings}" />
                <PathIcon Grid.Column="0" Data="{StaticResource IconCheck}" Width="14" Height="14" Margin="0,0,10,0"
                          Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasCheckFindings}" />
                <TextBlock Grid.Column="1" Text="{Binding CheckTitle}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="glyphBtn" Content="✕" Command="{Binding CloseCheckCommand}" ToolTip.Tip="{loc:Loc Check_Close}" />
            </Grid>
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasCheckFindings}">
                <ItemsControl ItemsSource="{Binding CheckFindings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CheckFindingItem">
                            <Grid ColumnDefinitions="Auto,150,*" Margin="0,2">
                                <Border Grid.Column="0" Classes="statusBadgeCard" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Top">
                                    <TextBlock Text="{loc:Loc Check_Mark}" Classes="badge" Foreground="{StaticResource AccentWarningBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Where}" Classes="dim" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" Spacing="1">
                                    <TextBlock Text="{Binding What}" FontSize="11.5" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Target}" Classes="dim" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
    </StackPanel>
</UserControl>
