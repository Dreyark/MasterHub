<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Pages"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Pages.ProfilesPageView"
             x:DataType="vm:ProfilesPageViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">
        <!-- Nagłówek -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="{loc:Loc Profiles_Title}" Classes="h2" />
            <TextBlock Text="{loc:Loc Profiles_Subtitle}" Classes="dim" />
        </StackPanel>

        <!-- Dodawanie nowego profilu oraz import z pliku JSON -->
        <Border Grid.Row="1" Classes="glassCard" Margin="0,0,0,16" Padding="14,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0" Text="{Binding NewProfileName}"
                         PlaceholderText="{loc:Loc Profiles_NewPlaceholder}" Margin="0,0,12,0"
                         VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="primaryBtn" Command="{Binding CreateProfileCommand}"
                        Padding="16,8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" />
                        <TextBlock Text="{loc:Loc Profiles_NewButton}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="glassBtn" Click="OnImportProfileClick"
                        ToolTip.Tip="{loc:Loc Profiles_ImportTip}"
                        Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconDownload}" Width="12" Height="12" />
                        <TextBlock Text="{loc:Loc Profiles_ImportBtn}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Komunikat statusu po operacji eksportu lub importu -->
        <Border Grid.Row="2" Classes="glassCard" Margin="0,0,0,16" Padding="14,10"
                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{StaticResource IconCheck}" Width="14" Height="14"
                          Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Lista profili z wyróżnieniem profilu aktywnego i opcją eksportu -->
        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileItemViewModel">
                        <Border Classes="glassCard" Classes.selected="{Binding IsActive}" Margin="0,0,0,10" Padding="16">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                        Background="{StaticResource CardBgBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconProfiles}" Width="18" Height="18"
                                              Foreground="{StaticResource AccentPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Border Classes="statusBadgeCard" IsVisible="{Binding IsActive}">
                                            <TextBlock Text="{loc:Loc Profiles_ActiveBadge}" Classes="badge"
                                                       Foreground="{StaticResource AccentPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" Classes="dim" FontSize="10" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Przycisk eksportu profilu do pliku JSON bez haseł -->
                                    <Button Classes="iconBtn" ToolTip.Tip="{loc:Loc Profiles_ExportTip}"
                                            Click="OnExportProfileClick" Tag="{Binding}">
                                        <PathIcon Data="{StaticResource IconUpload}" Width="13" Height="13"
                                                  Foreground="{StaticResource TextMutedBrush}" />
                                    </Button>
                                    <!-- Przycisk stanu aktywacji -->
                                    <Button Classes="pillBtn" Content="{loc:Loc Profiles_ActiveBtn}" IsEnabled="False" Opacity="0.6"
                                            IsVisible="{Binding IsActive}" />
                                    <Button Classes="pillBtn" Content="{loc:Loc Profiles_ActivateBtn}"
                                            IsVisible="{Binding !IsActive}"
                                            Command="{Binding $parent[UserControl].((vm:ProfilesPageViewModel)DataContext).ActivateProfileCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Classes="iconBtn" ToolTip.Tip="{loc:Loc Profiles_DeleteTip}"
                                            Command="{Binding $parent[UserControl].((vm:ProfilesPageViewModel)DataContext).DeleteProfileCommand}"
                                            CommandParameter="{Binding}">
                                        <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13"
                                                  Foreground="{StaticResource TextMutedBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
