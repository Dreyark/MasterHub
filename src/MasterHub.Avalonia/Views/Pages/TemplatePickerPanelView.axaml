<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Pages"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Pages.TemplatePickerPanelView"
             x:DataType="vm:TemplatePickerViewModel"
             IsVisible="{Binding IsOpen}">
    <!-- Gotowe profile: lista po lewej, podgląd siatki 3×5 i opis po prawej; dodanie dopiero po przejrzeniu. -->
    <Grid Background="{StaticResource ScrimBrush}">
        <Border Classes="glassCard" Background="{StaticResource PanelBgBrush}" Padding="20"
                Width="760" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{loc:Loc Templates_Title}" Classes="h2" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{loc:Loc Picker_Close}" Command="{Binding CloseCommand}" Classes="actionBtn" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="240,*" ColumnSpacing="16">
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TemplateItemViewModel">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,6" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Column="1" Spacing="10" DataContext="{Binding Selected}" x:DataType="vm:TemplateItemViewModel">
                        <TextBlock Text="{Binding Name}" Classes="h3" />
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Preview}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TemplateKeyPreview">
                                    <Border Background="{Binding Background}" CornerRadius="8" Margin="3" Height="44"
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding Title}" FontSize="9.5" FontWeight="SemiBold" TextAlignment="Center"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasApps}">
                            <TextBlock Text="{loc:Loc Templates_Apps}" Classes="dim" FontSize="10.5" />
                            <TextBlock Text="{Binding AppsText}" Classes="dim" FontSize="10.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <CheckBox IsChecked="{Binding LinkApps, Mode=TwoWay}" Content="{loc:Loc Templates_LinkApps}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="{loc:Loc Templates_Preview}" Command="{Binding PreviewCommand}" Classes="actionBtn" />
                        <Button Content="{loc:Loc Templates_Add}" Command="{Binding AddCommand}" Classes="accentBtn" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
