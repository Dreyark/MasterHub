<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Pages"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Pages.TwitchSettingsCardView"
             x:DataType="vm:SettingsPageViewModel">

    <Border Classes="glassCard" Padding="18">
        <StackPanel Spacing="14">
            <!-- Nagłówek i Status Połączenia Twitch -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconTwitch}" Width="18" Height="18"
                              Foreground="#9146FF" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc Twitch_Title}" Classes="h3" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="2" Background="{Binding TwitchConnectionStatusColor}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TwitchConnectionStatusText}" FontSize="11" FontWeight="Bold" Foreground="#0F1117" />
                </Border>
            </Grid>

            <TextBlock Text="{loc:Loc Twitch_Subtitle}" Classes="dim" FontSize="11" />

            <!-- Konfiguracja: Kanał, Bot Username, Token OAuth, Client ID -->
            <Grid ColumnDefinitions="*,12,*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc Twitch_ChannelLabel}" Classes="caption" />
                    <TextBox Text="{Binding TwitchChannel, Mode=TwoWay}" PlaceholderText="{loc:Loc Twitch_ChannelPlaceholder}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="{loc:Loc Twitch_BotUsernameLabel}" Classes="caption" />
                    <TextBox Text="{Binding TwitchBotUsername, Mode=TwoWay}" PlaceholderText="{loc:Loc Twitch_BotUsernamePlaceholder}" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,12,*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc Twitch_OAuthTokenLabel}" Classes="caption" />
                    <TextBox Text="{Binding TwitchOAuthToken, Mode=TwoWay}" PasswordChar="•" PlaceholderText="oauth:xxxxxxxxxxxxxxxxxxxxxx" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="{loc:Loc Twitch_ClientIdLabel}" Classes="caption" />
                    <TextBox Text="{Binding TwitchClientId, Mode=TwoWay}" PlaceholderText="{loc:Loc Twitch_ClientIdPlaceholder}" />
                </StackPanel>
            </Grid>

            <!-- Opcja Auto-Connect -->
            <Border Classes="statusBadgeCard" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{loc:Loc Twitch_AutoConnect}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{loc:Loc Twitch_AutoConnectDesc}" Classes="dim" FontSize="10" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding TwitchAutoConnect, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Przyciski akcji: Połącz/Rozłącz, Zapisz, Test czatu, Test klipu -->
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="pillBtn" Command="{Binding ConnectTwitchCommand}"
                            Content="{loc:Loc Twitch_ConnectBtn}" IsEnabled="{Binding !IsTwitchConnected}" />
                    <Button Classes="pillBtn" Command="{Binding DisconnectTwitchCommand}"
                            Content="{loc:Loc Twitch_DisconnectBtn}" IsEnabled="{Binding IsTwitchConnected}" />

                    <Button Classes="pillBtn" Command="{Binding SaveTwitchSettingsCommand}"
                            Content="{loc:Loc Twitch_SaveSettings}" />

                    <Button Classes="pillBtn" Command="{Binding TestTwitchMessageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="💬" FontSize="12" />
                            <TextBlock Text="{loc:Loc Twitch_TestChat}" />
                        </StackPanel>
                    </Button>

                    <Button Classes="pillBtn" Command="{Binding TestTwitchClipCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🎬" FontSize="12" />
                            <TextBlock Text="{loc:Loc Twitch_TestClip}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Komunikat statusu i wskazówka konfiguracyjna -->
                <TextBlock Text="{Binding TwitchStatusMessage}" Foreground="{Binding TwitchStatusMessageColor}"
                           FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc Twitch_ConfigTip}" Classes="dim" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
