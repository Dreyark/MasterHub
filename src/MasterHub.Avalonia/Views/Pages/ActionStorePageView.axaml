<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Pages"
             xmlns:pages="using:MasterHub.Avalonia.Views.Pages"
             xmlns:deck="using:MasterHub.Core.Integrations.StreamDeck"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             xmlns:ctl="using:MasterHub.Avalonia.Views.Controls"
             x:Class="MasterHub.Avalonia.Views.Pages.ActionStorePageView"
             x:DataType="vm:ActionStorePageViewModel">

    <Grid RowDefinitions="Auto,*" Margin="24">
        <ctl:PageHeader Grid.Row="0" Icon="{StaticResource IconStore}"
                        Title="{loc:Loc NavLabel_Store}" Subtitle="{loc:Loc Store_Subtitle}" />

        <!-- Zakładki: Integracje Wbudowane / Wtyczki Stream Deck -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Zakładka 1: Integracje Wbudowane -->
            <TabItem Header="{loc:Loc Store_TabBuiltIn}" FontSize="13" FontWeight="SemiBold">
                <ScrollViewer Margin="0,16,0,0">
                    <ItemsControl ItemsSource="{Binding Integrations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IntegrationStatusItem">
                                <Border Classes="glassCard" Margin="0,0,0,12" Padding="18">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="iconTile" Width="48" Height="48" CornerRadius="14" Margin="0,0,18,0">
                                            <PathIcon Data="{Binding Icon, Converter={x:Static ctl:IconConverters.ByKey}}" Width="24" Height="24"
                                                      Foreground="{StaticResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="statusBadgeCard" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{Binding StatusColor}" />
                                                <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Zakładka 2: Wtyczki Elgato Stream Deck -->
            <TabItem Header="{loc:Loc Store_TabStreamDeck}" FontSize="13" FontWeight="SemiBold">
                <Grid RowDefinitions="Auto,*" Margin="0,16,0,0">
                    <!-- Pasek narzędzi wtyczek -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,16">
                        <Button Grid.Column="0" Command="{Binding InstallPluginCommand}" Classes="accentBtn" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconStore}" Width="14" Height="14" />
                                <TextBlock Text="{loc:Loc Store_InstallPluginBtn}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Classes="actionBtn" Grid.Column="1" Command="{Binding OpenPluginsFolderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
                                <TextBlock Text="{loc:Loc Store_OpenFolderBtn}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Classes="dim" VerticalAlignment="Center" Margin="16,0" />
                        <Button Classes="actionBtn" Grid.Column="3" Command="{Binding RefreshPluginsCommand}" Content="{loc:Loc SD_Refresh}" />
                    </Grid>

                    <!-- Lista wtyczek -->
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:Loc Store_NoPlugins}" Classes="dim" Margin="10,20"
                                       IsVisible="{Binding !StreamDeckPlugins.Count}" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding StreamDeckPlugins}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StreamDeckPluginItemViewModel">
                                        <Border Classes="glassCard" Margin="0,0,0,12" Padding="16">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{StaticResource InsetBgBrush}" Margin="0,0,16,0" ClipToBounds="True">
                                                    <Panel>
                                                        <Image Source="{Binding PluginBitmap}" Width="36" Height="36"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               IsVisible="{Binding PluginBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <PathIcon Data="{StaticResource IconPlug}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding PluginBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="{loc:Loc SD_AuthorLabel}" Classes="dim" FontSize="10.5" /><TextBlock Text="{Binding Author}" Classes="dim" FontSize="10.5" /></StackPanel>
                                                        <TextBlock Text="{Binding ActionsCountDisplay}" Classes="dim" FontSize="10.5" Foreground="{StaticResource AccentPrimaryBrush}" />
                                                        <TextBlock Text="Node.js" Classes="dim" FontSize="10.5" Foreground="{StaticResource AccentSuccessBrush}" IsVisible="{Binding IsNodeJs}" />
                                                    </StackPanel>
                                                    <pages:PluginCompatView />

                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6" Margin="16,0,0,0">
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11" HorizontalAlignment="Right" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Classes="actionBtn" Command="{Binding $parent[pages:ActionStorePageView].((vm:ActionStorePageViewModel)DataContext).OpenPluginSettingsCommand}"
                                                                CommandParameter="{Binding}"
                                                               
                                                                ToolTip.Tip="{loc:Loc SD_PluginSettingsTip}" >
    <PathIcon Data="{StaticResource IconSettings}" Width="12" Height="12" />
</Button>
                                                        <Button Classes="actionBtn" Command="{Binding $parent[pages:ActionStorePageView].((vm:ActionStorePageViewModel)DataContext).TogglePluginCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding ToggleButtonText}" />
                                                        <Button Classes="actionBtn" Command="{Binding $parent[pages:ActionStorePageView].((vm:ActionStorePageViewModel)DataContext).UninstallPluginCommand}"
                                                                CommandParameter="{Binding}"
                                                               
                                                                ToolTip.Tip="{loc:Loc SD_UninstallTip}" >
    <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" />
</Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Zakładka 3: Katalog wtyczek online (Store) -->
            <TabItem Header="{loc:Loc Store_TabCatalog}" FontSize="13" FontWeight="SemiBold">
                <pages:PluginCatalogTabView DataContext="{Binding Catalog}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
