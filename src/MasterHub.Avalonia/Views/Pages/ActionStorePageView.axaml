<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Pages"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Pages.ActionStorePageView"
             x:DataType="vm:ActionStorePageViewModel">

    <Grid RowDefinitions="Auto,*" Margin="24">
        <!-- Nagłówek -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="{loc:Loc Store_Title}" Classes="h2" />
            <TextBlock Text="{loc:Loc Store_Subtitle}"
                       Classes="dim" />
        </StackPanel>

        <!-- Kafelki integracji -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Integrations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:IntegrationStatusItem">
                        <Border Classes="glassCard" Margin="0,0,0,12" Padding="18">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Classes="emoji" Text="{Binding Icon}" FontSize="32"
                                           FontFamily="Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji, sans-serif"
                                           VerticalAlignment="Center" Margin="0,0,18,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Description}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="2" Classes="statusBadgeCard" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{Binding IsOnline, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
