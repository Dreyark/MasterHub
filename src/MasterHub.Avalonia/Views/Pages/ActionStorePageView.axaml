<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Pages"
             xmlns:pages="using:MasterHub.Avalonia.Views.Pages"
             xmlns:deck="using:MasterHub.Core.Integrations.StreamDeck"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Pages.ActionStorePageView"
             x:DataType="vm:ActionStorePageViewModel">

    <Grid RowDefinitions="Auto,*" Margin="24">
        <!-- Nagłówek -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{loc:Loc Store_Title}" Classes="h2" />
            <TextBlock Text="{loc:Loc Store_Subtitle}" Classes="dim" />
        </StackPanel>

        <!-- Zakładki: Integracje Wbudowane / Wtyczki Stream Deck -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Zakładka 1: Integracje Wbudowane -->
            <TabItem Header="{loc:Loc Store_TabBuiltIn}" FontSize="13" FontWeight="SemiBold">
                <ScrollViewer Margin="0,16,0,0">
                    <ItemsControl ItemsSource="{Binding Integrations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IntegrationStatusItem">
                                <Border Classes="glassCard" Margin="0,0,0,12" Padding="18">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="emoji" Text="{Binding Icon}" FontSize="32"
                                                   FontFamily="Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji, sans-serif"
                                                   VerticalAlignment="Center" Margin="0,0,18,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="statusBadgeCard" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{Binding StatusColor}" />
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Zakładka 2: Wtyczki Elgato Stream Deck -->
            <TabItem Header="{loc:Loc Store_TabStreamDeck}" FontSize="13" FontWeight="SemiBold">
                <Grid RowDefinitions="Auto,*" Margin="0,16,0,0">
                    <!-- Pasek narzędzi wtyczek -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,16">
                        <Button Grid.Column="0" Command="{Binding InstallPluginCommand}" Classes="accent" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📦" FontSize="14" />
                                <TextBlock Text="{loc:Loc Store_InstallPluginBtn}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding OpenPluginsFolderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📂" FontSize="14" />
                                <TextBlock Text="{loc:Loc Store_OpenFolderBtn}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Classes="dim" VerticalAlignment="Center" Margin="16,0" />
                        <Button Grid.Column="3" Command="{Binding RefreshPluginsCommand}" Content="🔄 Odśwież" />
                    </Grid>

                    <!-- Lista wtyczek -->
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:Loc Store_NoPlugins}" Classes="dim" Margin="10,20"
                                       IsVisible="{Binding !StreamDeckPlugins.Count}" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding StreamDeckPlugins}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StreamDeckPluginItemViewModel">
                                        <Border Classes="glassCard" Margin="0,0,0,12" Padding="16">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#1C2030" Margin="0,0,16,0" ClipToBounds="True">
                                                    <Panel>
                                                        <Image Source="{Binding PluginBitmap}" Width="36" Height="36"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               IsVisible="{Binding PluginBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <TextBlock Text="🔌" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding PluginBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Author, StringFormat='Autor: {0}'}" Classes="dim" FontSize="10" />
                                                        <TextBlock Text="{Binding ActionsCountDisplay}" Classes="dim" FontSize="10" Foreground="{StaticResource AccentPrimaryBrush}" />
                                                        <TextBlock Text="Node.js" Classes="dim" FontSize="10" Foreground="#68D391" IsVisible="{Binding IsNodeJs}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6" Margin="16,0,0,0">
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11" HorizontalAlignment="Right" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Command="{Binding $parent[UserControl].((vm:ActionStorePageViewModel)DataContext).OpenPluginSettingsCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="⚙️"
                                                                ToolTip.Tip="Ustawienia wtyczki" />
                                                        <Button Command="{Binding $parent[UserControl].((vm:ActionStorePageViewModel)DataContext).TogglePluginCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding ToggleButtonText}" />
                                                        <Button Command="{Binding $parent[UserControl].((vm:ActionStorePageViewModel)DataContext).UninstallPluginCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="🗑️"
                                                                ToolTip.Tip="Odinstaluj wtyczkę" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Zakładka 3: Katalog wtyczek online (Store) -->
            <TabItem Header="{loc:Loc Store_TabCatalog}" FontSize="13" FontWeight="SemiBold">
                <pages:PluginCatalogTabView DataContext="{Binding Catalog}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
