<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
        xmlns:vm="using:MasterHub.Avalonia.ViewModels.Pages"
        xmlns:deck="using:MasterHub.Core.Integrations.StreamDeck"
        x:Class="MasterHub.Avalonia.Views.Pages.PluginSettingsWindow"
        x:DataType="vm:PluginSettingsViewModel"
        Title="MasterHub"
        Width="560" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource MainBgBrush}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Nagłówek wtyczki -->
        <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}" Padding="16,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{StaticResource InsetBgBrush}" Margin="0,0,12,0" ClipToBounds="True">
                    <Panel>
                        <Image Source="{Binding PluginBitmap}" Width="32" Height="32"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding PluginBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <PathIcon Data="{StaticResource IconPlug}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding PluginBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                    </Panel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding PluginName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                        <Border Background="{StaticResource InsetBgBrush}" CornerRadius="4" Padding="5,1" IsVisible="{Binding HasDials}">
                            <TextBlock Text="{loc:Loc SD_Win_HasDials}" FontSize="10.5" Foreground="{StaticResource AccentSuccessBrush}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding PluginUuid}" Classes="dim" FontSize="10.5" Foreground="{StaticResource AccentPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Zakładki ustawień -->
        <TabControl Grid.Row="1" Margin="8,4">
            <TabItem Header="{loc:Loc SD_Win_TabGlobal}" FontSize="12">
                <ScrollViewer Margin="8,10">
                    <StackPanel Spacing="12">
                        <Button Command="{Binding OpenGlobalPropertyInspectorCommand}"
                                Classes="accentBtn"
                                HorizontalAlignment="Stretch"
                                Padding="10,8"
                                IsVisible="{Binding HasPropertyInspector}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource IconGlobe}" Width="14" Height="14" />
                                <TextBlock Text="{loc:Loc SD_Win_OpenPluginPI}" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc SD_Win_GlobalJsonLabel}" Classes="caption" />
                            <TextBox Text="{Binding GlobalSettingsJson, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="130"
                                     MaxHeight="220"
                                     FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                                     FontSize="11"
                                     Background="{StaticResource InsetBgBrush}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Classes="dim" Foreground="{StaticResource AccentSuccessBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="{loc:Loc SD_Win_FormatJson}" Command="{Binding FormatJsonCommandCommand}" Classes="pillBtn" Padding="10,6" Margin="0,0,6,0" />
                            <Button Grid.Column="2" Content="{loc:Loc SD_Win_Save}" Command="{Binding SaveGlobalSettingsCommand}" Classes="accentBtn" Padding="12,6" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Loc SD_Win_TabActions}" FontSize="12">
                <ScrollViewer Margin="8,10">
                    <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="deck:StreamDeckActionManifest">
                                <Border Classes="glassCard" Margin="0,0,0,8" Padding="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <Border Background="{StaticResource InsetBgBrush}" CornerRadius="3" Padding="4,1">
                                                    <TextBlock Text="{Binding ControllersDisplay}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding UUID}" Classes="dim" FontSize="10.5" />
                                            <TextBlock Text="{Binding Tooltip}" Classes="dim" FontSize="10.5" TextWrapping="Wrap"
                                                       IsVisible="{Binding Tooltip, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{loc:Loc SD_Win_OpenInPI}"
                                                Command="{Binding $parent[Window].((vm:PluginSettingsViewModel)DataContext).OpenActionPropertyInspectorCommand}"
                                                CommandParameter="{Binding UUID}"
                                                Classes="pillBtn" Padding="8,4" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Dolny pasek akcji -->
        <Border Grid.Row="2" Background="{StaticResource PanelBgBrush}" Padding="16,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Button Grid.Column="0" Content="{loc:Loc SD_Win_Folder}" Command="{Binding OpenFolderCommand}" Classes="pillBtn" Padding="10,6" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="{loc:Loc SD_Win_Repo}" Command="{Binding OpenUrlCommand}" Classes="pillBtn" Padding="10,6" IsVisible="{Binding HasUrl}" />
                <Button Grid.Column="3" Content="{loc:Loc Common_Close}" Command="{Binding CloseCommand}" Classes="pillBtn" Padding="14,6" />
            </Grid>
        </Border>
    </Grid>
</Window>
