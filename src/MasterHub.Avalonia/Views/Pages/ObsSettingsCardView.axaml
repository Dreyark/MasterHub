<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Pages"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Pages.ObsSettingsCardView"
             x:DataType="vm:SettingsPageViewModel">

    <Border Classes="glassCard" Padding="18">
        <StackPanel Spacing="14">
            <!-- Nagłówek i Status Połączenia OBS -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconObs}" Width="18" Height="18"
                              Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc Obs_Title}" Classes="h3" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="2" Background="{Binding ObsConnectionStatusColor}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ObsConnectionStatusText}" FontSize="11" FontWeight="Bold" Foreground="#0F1117" />
                </Border>
            </Grid>

            <TextBlock Text="{loc:Loc Obs_Subtitle}" Classes="dim" FontSize="11" />

            <!-- Konfiguracja połączenia (Host, Port, Hasło) -->
            <Grid ColumnDefinitions="2*,12,*,12,2*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc Obs_HostLabel}" Classes="caption" />
                    <TextBox Text="{Binding ObsHost, Mode=TwoWay}" PlaceholderText="localhost" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="{loc:Loc Obs_PortLabel}" Classes="caption" />
                    <TextBox Text="{Binding ObsPort, Mode=TwoWay}" PlaceholderText="4455" />
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="4">
                    <TextBlock Text="{loc:Loc Obs_PasswordLabel}" Classes="caption" />
                    <TextBox Text="{Binding ObsPassword, Mode=TwoWay}" PasswordChar="•" PlaceholderText="{loc:Loc Obs_PasswordPlaceholder}" />
                </StackPanel>
            </Grid>

            <!-- Opcja Auto-Connect -->
            <Border Classes="statusBadgeCard" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{loc:Loc Obs_AutoConnect}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{loc:Loc Obs_AutoConnectDesc}" Classes="dim" FontSize="10" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding ObsAutoConnect, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Przyciski akcji: Połącz/Rozłącz, Wczytaj z OBS, Zapisz, Test Stream/Record -->
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="pillBtn" Command="{Binding ConnectObsCommand}"
                            Content="{loc:Loc Obs_ConnectBtn}" IsEnabled="{Binding !IsObsConnected}" />
                    <Button Classes="pillBtn" Command="{Binding DisconnectObsCommand}"
                            Content="{loc:Loc Obs_DisconnectBtn}" IsEnabled="{Binding IsObsConnected}" />

                    <Button Classes="pillBtn" Command="{Binding AutoDetectObsSettingsCommand}"
                            Content="{loc:Loc Obs_AutoDetectBtn}" />

                    <Button Classes="pillBtn" Command="{Binding SaveObsSettingsCommand}"
                            Content="{loc:Loc Obs_SaveSettings}" />

                    <Button Classes="pillBtn" Command="{Binding TestObsStreamCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconStudio}" Width="12" Height="12" />
                            <TextBlock Text="{loc:Loc Obs_TestStream}" />
                        </StackPanel>
                    </Button>

                    <Button Classes="pillBtn" Command="{Binding TestObsRecordCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconVideo}" Width="12" Height="12" />
                            <TextBlock Text="{loc:Loc Obs_TestRecord}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Komunikat statusu i wskazówka konfiguracyjna -->
                <TextBlock Text="{Binding ObsStatusMessage}" Foreground="{Binding ObsStatusMessageColor}"
                           FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc Obs_ConfigTip}" Classes="dim" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
