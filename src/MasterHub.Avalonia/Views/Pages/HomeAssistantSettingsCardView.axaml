<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Pages"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Pages.HomeAssistantSettingsCardView"
             x:DataType="vm:SettingsPageViewModel">

    <Border Classes="glassCard" Padding="18">
        <StackPanel Spacing="14">
            <!-- Nagłówek i Status Połączenia Home Assistant -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="💡" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc HA_Title}" Classes="h3" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="2" Background="{Binding HomeAssistantConnectionStatusColor}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HomeAssistantConnectionStatusText}" FontSize="11" FontWeight="Bold" Foreground="#0F1117" />
                </Border>
            </Grid>

            <TextBlock Text="{loc:Loc HA_Subtitle}" Classes="dim" FontSize="11" />

            <!-- Adres serwera Home Assistant -->
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc HA_ServerUrlLabel}" Classes="caption" />
                <TextBox Text="{Binding HomeAssistantServerUrl, Mode=TwoWay}" PlaceholderText="http://homeassistant.local:8123" />
            </StackPanel>

            <!-- Długoterminowy token dostępu (Long-Lived Access Token) -->
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc HA_TokenLabel}" Classes="caption" />
                <TextBox Text="{Binding HomeAssistantAccessToken, Mode=TwoWay}" PasswordChar="●"
                         PlaceholderText="{loc:Loc HA_TokenPlaceholder}" />
            </StackPanel>

            <!-- Opcja automatycznego łączenia -->
            <StackPanel Spacing="8">
                <CheckBox IsChecked="{Binding HomeAssistantAutoConnect, Mode=TwoWay}"
                          Content="{loc:Loc HA_AutoConnect}" FontSize="12" />
            </StackPanel>

            <!-- Przyciski akcji, testów i zapisu -->
            <StackPanel Spacing="8">
                <WrapPanel Orientation="Horizontal">
                    <Button Classes="pillBtn" Command="{Binding ConnectHomeAssistantCommand}"
                            IsEnabled="{Binding !IsHomeAssistantConnected}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔗" FontSize="12" />
                            <TextBlock Text="{loc:Loc HA_ConnectBtn}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="pillBtn" Command="{Binding DisconnectHomeAssistantCommand}"
                            IsEnabled="{Binding IsHomeAssistantConnected}" Content="{loc:Loc HA_DisconnectBtn}" Margin="0,0,8,8" />
                    <Button Classes="pillBtn" Command="{Binding TestHomeAssistantConnectionCommand}"
                            Content="{loc:Loc HA_TestBtn}" Margin="0,0,8,8" />
                    <Button Classes="pillBtn" Command="{Binding SaveHomeAssistantSettingsCommand}"
                            Content="{loc:Loc HA_SaveBtn}" Margin="0,0,8,8" />
                </WrapPanel>

                <!-- Komunikat statusu i wskazówka -->
                <TextBlock Text="{Binding HomeAssistantStatusMessage}" Foreground="{Binding HomeAssistantStatusMessageColor}"
                           FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc HA_ConfigTip}" Classes="dim" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
