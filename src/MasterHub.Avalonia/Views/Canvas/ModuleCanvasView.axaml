<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Canvas"
             xmlns:canvas="using:MasterHub.Avalonia.Views.Canvas"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Canvas.ModuleCanvasView"
             x:DataType="vm:CanvasViewModel">

    <Grid RowDefinitions="Auto,*" Margin="16">
        <!-- Pasek narzędziowy kanwy -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <PathIcon Data="{StaticResource IconStudio}" Width="18" Height="18"
                          Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Loc Canvas_ConfiguratorTitle}" Classes="h2" VerticalAlignment="Center" />
                <Border Classes="statusBadgeCard">
                    <TextBlock Text="{loc:Loc Canvas_ModularLayout}" Classes="badge" />
                </Border>
                <Button Classes="pillBtn" Command="{Binding CycleRotationCommand}"
                        ToolTip.Tip="{loc:Loc Canvas_RotationTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconRotate}" Width="13" Height="13"
                                  Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OrientationStatusText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Classes="pillBtn" Classes.active="{Binding IsFilterAll}"
                        Command="{Binding SetFilterCommand}" CommandParameter="Wszystko"
                        Content="{loc:Loc Canvas_FilterAll}" />
                <Button Classes="pillBtn" Classes.active="{Binding IsFilterKeys}"
                        Command="{Binding SetFilterCommand}" CommandParameter="Przyciski"
                        Content="{loc:Loc Canvas_FilterKeys}" />
                <Button Classes="pillBtn" Classes.active="{Binding IsFilterSliders}"
                        Command="{Binding SetFilterCommand}" CommandParameter="Suwaki"
                        Content="{loc:Loc Canvas_FilterSliders}" />
                <Button Classes="pillBtn" Classes.active="{Binding IsFilterRollers}"
                        Command="{Binding SetFilterCommand}" CommandParameter="Pokrętła"
                        Content="{loc:Loc Canvas_FilterRollers}" />
                <Button Classes="pillBtn" Classes.active="{Binding IsFilterBase}"
                        Command="{Binding SetFilterCommand}" CommandParameter="Podstawka"
                        Content="{loc:Loc Canvas_FilterBase}" />
            </StackPanel>
        </Grid>

        <!-- Obszar przewijany modułów z obsługą odznaczania po kliknięciu w tło -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="Transparent"
                      PointerPressed="OnCanvasBackgroundPointerPressed">
            <StackPanel HorizontalAlignment="Center" Spacing="16" Margin="0,0,0,24">
                <!-- Rząd górny: Podstawka dokująca (pionowo po lewej) + Klawiatura LCD -->
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <canvas:BaseStationView Margin="0,0,16,16" IsVisible="{Binding ShowBase}" />
                    <canvas:KeysModuleView Margin="0,0,0,16" IsVisible="{Binding ShowKeys}" />
                </WrapPanel>

                <!-- Rząd dolny: Suwaki + Rolki w układzie horyzontalnym z zawijaniem -->
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <canvas:SlidersModuleView Margin="0,0,16,16" IsVisible="{Binding ShowSliders}" />
                    <canvas:RollersModuleView Margin="0,0,16,16" IsVisible="{Binding ShowRollers}" />
                </WrapPanel>

                <!-- Trzeci rząd: Dodatkowe moduły Cooler Master (3 Pokrętła + Dial IPS) -->
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <canvas:KnobsModuleView Margin="0,0,16,16" IsVisible="{Binding ShowKnobs}" />
                    <canvas:DialModuleView Margin="0,0,0,16" IsVisible="{Binding ShowDial}" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
