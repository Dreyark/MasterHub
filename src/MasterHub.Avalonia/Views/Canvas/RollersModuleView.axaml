<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Canvas"
             xmlns:elem="using:MasterHub.Avalonia.ViewModels"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Canvas.RollersModuleView"
             x:DataType="vm:CanvasViewModel">

    <Border Classes="moduleContainer" HorizontalAlignment="Center">
        <StackPanel Spacing="12">
            <!-- Nagłówek modułu -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{loc:Loc Canvas_Rollers_Title}" Classes="h3" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{loc:Loc Canvas_Rollers_Subtitle}" Classes="dim" VerticalAlignment="Center" />
            </Grid>

            <!-- 2 Rolki obrotowe (wyśrodkowane w module) -->
            <ItemsControl ItemsSource="{Binding Rollers}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="elem:RollerItemViewModel">
                        <Border Width="130" Height="140" Classes="glassCard"
                                Classes.selected="{Binding IsSelected}"
                                Padding="12" PointerPressed="OnRollerPointerPressed">
                            <Grid RowDefinitions="Auto,*,Auto" HorizontalAlignment="Center">
                                <!-- Nazwa rolki -->
                                <TextBlock Grid.Row="0" Text="{Binding Name}" Classes="caption"
                                           HorizontalAlignment="Center" />

                                <!-- Graficzny symbol pokrętła / rolki -->
                                <Border Grid.Row="1" Width="56" Height="56" CornerRadius="28"
                                        Background="{StaticResource CardActiveBgBrush}"
                                        BorderBrush="{StaticResource AccentSecondaryBrush}"
                                        BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                        <PathIcon Data="{StaticResource IconRotate}" Width="15" Height="15"
                                                  Foreground="{StaticResource AccentSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding LastDirection}" FontSize="9"
                                                   Foreground="{StaticResource AccentSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Licznik kroków i akcja -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Canvas_Step}" Classes="dim" FontSize="10" />
                                    <TextBlock Text="{Binding StepsDisplay}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
