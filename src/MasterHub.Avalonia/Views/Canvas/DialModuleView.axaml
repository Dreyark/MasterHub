<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MasterHub.Avalonia.ViewModels.Canvas"
             xmlns:loc="using:MasterHub.Avalonia.Localization"
             x:Class="MasterHub.Avalonia.Views.Canvas.DialModuleView"
             x:DataType="vm:CanvasViewModel">

    <Border Classes="moduleContainer" HorizontalAlignment="Center">
        <StackPanel Spacing="12">
            <!-- Nagłówek modułu Dial IPS -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{loc:Loc Canvas_Dial_Title}" Classes="h3" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{loc:Loc Canvas_Dial_Subtitle}" Classes="dim" VerticalAlignment="Center" />
            </Grid>

            <!-- Tarcza obrotowa Dial z centralnym ekranem IPS 240x240 -->
            <Border Width="160" Height="140" Classes="glassCard"
                    Classes.selected="{Binding Dial.IsSelected}"
                    Padding="10" PointerPressed="OnDialPointerPressed"
                    HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" HorizontalAlignment="Center">
                    <!-- Tytuł manipulatora -->
                    <TextBlock Grid.Row="0" Text="{Binding Dial.Name}" Classes="caption"
                               HorizontalAlignment="Center" />

                    <!-- Duża okrągła tarcza ze zintegrowanym ekranem IPS -->
                    <Border Grid.Row="1" Width="68" Height="68" CornerRadius="34"
                            Background="{StaticResource CardActiveBgBrush}"
                            BorderBrush="{Binding Dial.ColorBrush}"
                            BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="50" Height="50" CornerRadius="25"
                                Background="#10141E" ClipToBounds="True">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                <PathIcon Data="{StaticResource IconRotate}" Width="14" Height="14"
                                          Foreground="{Binding Dial.ColorBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Dial.LastDirection}" FontSize="8.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Licznik kroków i stan -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="{loc:Loc Canvas_Step}" Classes="dim" FontSize="10" />
                        <TextBlock Text="{Binding Dial.StepsDisplay}" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
