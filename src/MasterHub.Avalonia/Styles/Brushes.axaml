<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Pędzle jednolite bazujące na słowniku Colors -->
    <SolidColorBrush x:Key="MainBgBrush" Color="{StaticResource MainBgColor}" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardHoverBgBrush" Color="{StaticResource CardHoverBgColor}" />
    <SolidColorBrush x:Key="CardActiveBgBrush" Color="{StaticResource CardActiveBgColor}" />
    <SolidColorBrush x:Key="CardSoftBrush" Color="{StaticResource CardSoftColor}" />

    <!-- Obramowania -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderAccentBrush" Color="{StaticResource BorderAccentColor}" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="{StaticResource BorderGlowColor}" />

    <!-- Akcenty neonowo-pastelowe -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="{StaticResource AccentWarningColor}" />
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="{StaticResource AccentSuccessColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="{StaticResource HoverOverlayColor}" />
    <SolidColorBrush x:Key="FloatingBgBrush" Color="{StaticResource FloatingBgColor}" />
    <SolidColorBrush x:Key="FloatingBorderBrush" Color="{StaticResource FloatingBorderColor}" />

    <!-- Kolory semantyczne -->
    <SolidColorBrush x:Key="AccentInfoBrush" Color="{StaticResource AccentInfoColor}" />
    <SolidColorBrush x:Key="AccentCautionBrush" Color="{StaticResource AccentCautionColor}" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}" />
    <!-- Tekst na jaskrawym tle statusu / akcentu -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <!-- Wpuszczone tło (pola edycji JSON, kafelki ikon, chipy) -->
    <SolidColorBrush x:Key="InsetBgBrush" Color="{StaticResource InsetBgColor}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />

    <!-- Typografia -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />

    <!-- Gradienty Cyberpunk Pastel Glow -->
    <LinearGradientBrush x:Key="CyberGlowBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#5E81F4" Offset="0.0" />
        <GradientStop Color="#8A64EB" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Tło okna i paneli: miękki gradient granatowo-indygo (jak w referencjach) -->
    <LinearGradientBrush x:Key="WindowBgBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#191A34" Offset="0.0" />
        <GradientStop Color="#10111F" Offset="0.55" />
        <GradientStop Color="#0D0E1B" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#222546" Offset="0.0" />
        <GradientStop Color="#1A1C33" Offset="0.6" />
        <GradientStop Color="#171930" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#2B2E44" Offset="0.0" />
        <GradientStop Color="#222536" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>
