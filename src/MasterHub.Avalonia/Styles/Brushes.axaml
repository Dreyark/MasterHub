<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Pędzle jednolite bazujące na słowniku Colors -->
    <SolidColorBrush x:Key="MainBgBrush" Color="{StaticResource MainBgColor}" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardHoverBgBrush" Color="{StaticResource CardHoverBgColor}" />
    <SolidColorBrush x:Key="CardActiveBgBrush" Color="{StaticResource CardActiveBgColor}" />

    <!-- Obramowania -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderAccentBrush" Color="{StaticResource BorderAccentColor}" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="{StaticResource BorderGlowColor}" />

    <!-- Akcenty neonowo-pastelowe -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="{StaticResource AccentWarningColor}" />
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="{StaticResource AccentSuccessColor}" />

    <!-- Typografia -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />

    <!-- Gradienty Cyberpunk Pastel Glow -->
    <LinearGradientBrush x:Key="CyberGlowBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#5E81F4" Offset="0.0" />
        <GradientStop Color="#8A64EB" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#2D2F45" Offset="0.0" />
        <GradientStop Color="#242537" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>
