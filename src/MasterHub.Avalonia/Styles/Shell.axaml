<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Powłoka aplikacji: boczny pasek nawigacji (navItem, sidebar.collapsed), pływające panele stron (pagePanel),
        nagłówek strony (pageIconChip), podpowiedzi (callout) i przełącznik segmentowy (segmented + pillBtn).
        Stany Fluent celują w ContentPresenter#PART_ContentPresenter (patrz komentarz w Buttons.axaml).
    -->

    <!-- Pozycja nawigacji: ikona + etykieta, pełna szerokość paska -->
    <Style Selector="Button.navItem">
        <Setter Property="Height" Value="42" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.navItem PathIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.navItem TextBlock.navLabel">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.navItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.navItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverOverlayBrush}" />
    </Style>
    <Style Selector="Button.navItem:pointerover PathIcon">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.navItem:pointerover TextBlock.navLabel">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.navItem:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <!-- Aktywna strona: wypełniona pastylka z poświatą akcentu (jak w referencji "Dashboard") -->
    <Style Selector="Button.navItem.active /template/ ContentPresenter#PART_ContentPresenter, Button.navItem.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="BoxShadow" Value="0 6 18 0 #285E81F4" />
    </Style>
    <Style Selector="Button.navItem.active PathIcon">
        <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}" />
    </Style>
    <Style Selector="Button.navItem.active TextBlock.navLabel">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Pasek boczny: rozwinięty (ikony + etykiety) / zwinięty (same ikony z podpowiedziami) -->
    <Style Selector=":is(UserControl).sidebar">
        <Setter Property="Width" Value="248" />
    </Style>
    <Style Selector=":is(UserControl).sidebar.collapsed">
        <Setter Property="Width" Value="108" />
    </Style>
    <Style Selector=".sidebar.collapsed TextBlock.navLabel, .sidebar.collapsed TextBlock.overline, .sidebar.collapsed StackPanel.brandText">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=".sidebar.collapsed Button.navItem">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <!-- W zwiniętym pasku etykiety grup zastępuje cienka linia -->
    <Style Selector="Border.navDivider">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="10,6" />
        <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}" />
    </Style>
    <Style Selector=".sidebar.collapsed Border.navDivider">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Pływający panel strony na ramie okna -->
    <Style Selector="Border.sideCard">
        <Setter Property="Background" Value="{StaticResource PanelGradientBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="BoxShadow" Value="0 10 30 0 #40000000" />
    </Style>
    <Style Selector="Border.pagePanel">
        <Setter Property="Background" Value="{StaticResource PanelGradientBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BoxShadow" Value="0 10 30 0 #40000000" />
    </Style>

    <!-- Kafelek ikony w nagłówku strony -->
    <Style Selector="Border.pageIconChip">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</Styles>
